# Required application services
OPENAI_API_KEY=replace-with-secret-manager-reference
APPLICATION_TIMEZONE=UTC
EVALUATION_MODEL=gpt-4o-mini
EVALUATION_TIMEOUT_SECONDS=12
EVALUATION_USER_REQUESTS_PER_5_MINUTES=3
EVALUATION_GLOBAL_REQUESTS_PER_MINUTE=60
EVALUATION_MAX_CONCURRENCY=8

# Supabase persistence and authentication
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=replace-with-service-role-key

# Defaults below match standard Supabase access tokens. Override only when the
# Supabase project has intentionally configured different values.
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
# Optional: defaults to $SUPABASE_URL/auth/v1/.well-known/jwks.json
# SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Required only for Supabase projects still signing user access tokens with
# legacy HS256. Never use the anon key or service-role key as this value.
# SUPABASE_JWT_SECRET=replace-with-legacy-jwt-secret

# Paddle Billing (use sandbox credentials for local/staging verification)
PADDLE_API_KEY=pdl_sdbx_replace-me
PADDLE_API_URL=https://sandbox-api.paddle.com
PADDLE_PRICE_ID=pri_default
PADDLE_ALLOWED_PRICE_IDS=pri_monthly,pri_yearly
PADDLE_RETURN_URL=http://localhost:3000/growth?plan=premium
PADDLE_CANCEL_URL=http://localhost:3000/growth?plan=free
# Secret for this exact Paddle notification destination, not an API key.
PADDLE_WEBHOOK_SECRET=pdl_ntfset_replace-me
PADDLE_WEBHOOK_TOLERANCE_SECONDS=5
PADDLE_CHECKOUT_CORRELATION_TTL_MINUTES=60
PADDLE_PAST_DUE_GRACE_DAYS=7
PADDLE_RECONCILIATION_MAX_PAGES=100

ALLOWED_ORIGINS=["http://localhost:3000"]
