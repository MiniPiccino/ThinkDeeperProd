NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-anon-key
NEXT_PUBLIC_USE_MOCKS=false
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_EXPECTED_SUPABASE_PROJECT_REF=your-project-ref

# Staging must use a Paddle sandbox client-side token (prefix: test_).
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_replace-with-sandbox-client-token

# Price IDs are display/selection values only. The backend allowlist is authoritative.
NEXT_PUBLIC_PADDLE_PRICE_ID_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_ID_YEARLY=
